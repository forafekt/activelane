{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activelane.dev/schemas/extension-manifest.schema.json",
  "title": "ActiveLane extension manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "publisher",
    "name",
    "displayName",
    "version",
    "description",
    "entry",
    "engines",
    "hostSupport",
    "extensionKind"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "publisher": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "engines": {
      "type": "object",
      "required": ["activelane"],
      "properties": { "activelane": { "type": "string", "minLength": 1 } }
    },
    "hostSupport": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["webapp", "desktop", "browser-extension", "server"] }
    },
    "extensionKind": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["workbench", "server"] }
    },
    "os": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["linux", "darwin", "windows"] }
    },
    "architecture": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["amd64", "arm64", "386"] }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["extension-storage"] }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "containers": { "type": "array", "items": { "type": "object", "required": ["id", "title", "location"], "properties": {
          "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
          "location": { "enum": ["primary-sidebar", "secondary-sidebar", "editor", "panel", "auxiliary"] }
        } } },
        "views": { "type": "array", "items": { "type": "object", "required": ["id", "title", "container", "renderer"], "properties": {
          "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "container": { "type": "string", "minLength": 1 },
          "renderer": { "type": "object", "required": ["type", "entry"], "properties": { "type": { "const": "isolated" }, "entry": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).*\\.html$" } } }
        } } }
      }
    }
  }
}
