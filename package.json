{
  "name": "activelane-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:desktop",
    "dev:frontend": "pnpm --dir apps/desktop/frontend dev",
    "dev:desktop": "cd apps/desktop && wails3 dev",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:fix:unsafe": "biome check --write --unsafe .",
    "format:spacing": "node scripts/fmt/top-level-spacing.mjs --write .",
    "format:spacing:check": "node scripts/fmt/top-level-spacing.mjs --check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "pnpm -r --filter './packages/*' --if-present run build:types && pnpm -r --filter './packages/*' --filter desktop --if-present run typecheck",
    "build": "pnpm -r --filter './packages/*' --filter desktop --if-present run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.12.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^24.12.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.5"
  }
}
