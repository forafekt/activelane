{
  "name": "activelane-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm exec concurrently \"pnpm run dev:registry\" \"pnpm run dev:desktop\"",
    "dev:webapp": "pnpm --filter webapp dev",
    "dev:desktop": "pnpm --filter desktop dev:electron",
    "dev:server": "pnpm --filter @activelane/server watch",
    "dev:registry": "node ./scripts/dev-registry.mjs",
    "dev:alx": "pnpm --filter @activelane/alx watch",
    "dev:workbench-api": "pnpm --filter @activelane/workbench-api watch",
    "vitem": "vitem",
    "vitem:dev": "vitem dev",
    "vitem:inspect": "vitem doctor --json",
    "alx": "node ./packages/alx/dist/cli.js",
    "al-registry": "node ./services/al-registry-server/dist/cli.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:fix:unsafe": "biome check --write --unsafe .",
    "format:spacing": "node scripts/fmt/top-level-spacing.mjs --write .",
    "format:spacing:check": "node scripts/fmt/top-level-spacing.mjs --check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "pnpm -r --filter './packages/*' --if-present run build:types && pnpm -r --if-present run typecheck",
    "prepare": "simple-git-hooks",
    "clean:prune": "rimraf --glob **/node_modules **/pnpm-lock.yaml **/dist",
    "clean:install": "pnpm clean:prune && pnpm install && pnpm -r build",
    "clean:vue-dts": "find packages -type f -path \"*/src/*.vue.d.ts\" -delete",
    "clean:dts": "find packages -type f -path \"*/src/*.d.ts\" -delete",
    "clean:js": "find packages -type f -path \"*/src/*.js\" -delete",
    "clean:node_modules": "find packages -type f -path \"*/node_modules\" -delete"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.12.0",
  "devDependencies": {
    "wsrt": "link:../wsrt/packages/wsrt",
    "@wsrt/plugin-dashboard": "link:../wsrt/plugins/dashboard",
    "@wsrt/plugin-vite": "link:../wsrt/plugins/vite",
    "@wsrt/plugin-workbench": "link:../wsrt/plugins/workbench",
    "@biomejs/biome": "^2.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.0",
    "@vscode/vsce": "^3.9.0",
    "better-sqlite3": "^12.9.0",
    "lint-staged": "^16.4.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
