{
  "schemaVersion": "1.0.0", "id": "@activelane/api-studio", "publisher": "activelane", "name": "api-studio", "displayName": "ActiveLane API Studio", "version": "0.1.0",
  "description": "Framework-neutral isolated applications backed by one API Studio runtime.", "entry": "dist/extension.js", "engines": { "activelane": ">=0.1.0" },
  "hostSupport": ["desktop", "webapp"], "extensionKind": ["workbench"], "visibility": "public", "permissions": ["extension-storage"],
  "contributes": {
    "activityRail": [{ "id": "api-studio.navigation", "title": "API Studio", "defaultSidebarViewId": "api-studio.navigation" }],
    "containers": [
      { "id": "api-studio.navigation", "location": "primary-sidebar", "title": "API Studio", "icon": "lucide:braces" },
      { "id": "api-studio.editors", "location": "editor", "title": "Requests" },
      { "id": "api-studio.inspector", "location": "secondary-sidebar", "title": "Request Inspector" },
      { "id": "api-studio.log", "location": "panel", "title": "Request Log" }
    ],
    "views": [
      { "id": "api-studio.sidebar", "container": "api-studio.navigation", "title": "Collections", "renderer": { "type": "isolated", "entry": "dist/views/sidebar/index.html" }, "capabilities": ["apiStudio.requests.list"] },
      { "id": "api-studio.request-editor", "container": "api-studio.editors", "title": "Request", "multiple": true, "renderer": { "type": "isolated", "entry": "dist/views/editor/index.html" }, "capabilities": ["apiStudio.requests.list"] },
      { "id": "api-studio.request-inspector", "container": "api-studio.inspector", "title": "Inspector", "renderer": { "type": "isolated", "entry": "dist/views/inspector/index.html" } },
      { "id": "api-studio.request-log", "container": "api-studio.log", "title": "Request Log", "renderer": { "type": "isolated", "entry": "dist/views/log/index.html" } }
    ],
    "commands": [
      { "id": "api-studio.open-users", "title": "API Studio: Open Users Request" },
      { "id": "api-studio.open-orders", "title": "API Studio: Open Orders Request" },
      { "id": "api-studio.open-settings", "title": "API Studio: Open Settings Request" }
    ]
  }
}
