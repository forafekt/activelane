{
  "name": "@activelane/workbench",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Host-agnostic ActiveLane workbench shell for activity, sidebar, tabs, split groups, and inspector layout.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "development": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./marketplace": {
      "development": "./src/marketplace/index.ts",
      "types": "./dist/marketplace/index.d.ts",
      "import": "./dist/marketplace/index.js"
    },
    "./themes": {
      "development": "./src/themes/index.ts",
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./extensions": {
      "development": "./src/extensions/index.ts",
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    }
  },
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles/index.css"
  ],
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.mjs",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@activelane/icons": "workspace:*",
    "@activelane/shadcn": "workspace:*",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  },
  "keywords": [
    "activelane",
    "workbench",
    "vue"
  ],
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
