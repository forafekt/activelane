{
  "name": "@activelane/workbench",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Host-agnostic ActiveLane workbench shell for activity, sidebar, tabs, split groups, and inspector layout.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./marketplace": {
      "types": "./dist/marketplace/index.d.ts",
      "import": "./dist/marketplace/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    }
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 & vite build --watch",
    "build": "pnpm build:types && vite build",
    "build:types": "pnpm exec vue-tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test tests/*.mjs",
    "typecheck": "pnpm exec vue-tsc -p tsconfig.app.json --noEmit && pnpm exec tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@activelane/icons": "workspace:*",
    "@activelane/shadcn": "workspace:*",
    "@activelane/workbench-api": "workspace:*",
    "@vueuse/core": "^13.9.0",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^2.0.5",
    "vue-tsc": "^3.2.6"
  },
  "keywords": [
    "activelane",
    "workbench",
    "vue"
  ],
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
