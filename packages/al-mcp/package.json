{
  "name": "@activelane/mcp",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP primitives, local transport, client, server, and capability routing for ActiveLane.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:types && pnpm exec tsc -p tsconfig.build.json",
    "build:types": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@activelane/workbench-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "vite": "^8.0.1",
    "vitest": "^2.0.5"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
