{
  "name": "@activelane/workbench-api",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Canonical public contracts for the ActiveLane workbench runtime and extension API.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    }
  },
  "scripts": {
    "watch": "vite build --watch",
    "build": "pnpm run build:types &&  vite build",
    "build:types": "pnpm exec tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test tests/*.mjs",
    "typecheck": "pnpm exec tsc -p tsconfig.app.json --noEmit && pnpm exec tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@activelane/icons": "workspace:*",
    "@activelane/shadcn": "workspace:*",
    "@vue/tsconfig": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.0.1",
    "vitest": "^2.0.5"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
