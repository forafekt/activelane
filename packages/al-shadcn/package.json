{
  "name": "@activelane/shadcn",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "ActiveLane premium Vue design system built on shadcn-vue, Reka UI, and Tailwind CSS.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "components.json"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "development": "./src/styles/index.css",
      "default": "./dist/styles.css"
    }
  },
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles/index.css"
  ],
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.mjs",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@activelane/icons": "workspace:*",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.6.1",
    "shadcn-vue": "^2.6.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  },
  "keywords": [
    "activelane",
    "shadcn-vue",
    "reka-ui",
    "vue",
    "tailwindcss",
    "design-system"
  ],
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
