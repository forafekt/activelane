{
  "name": "@activelane/shadcn",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "ActiveLane premium Vue design system built on shadcn-vue, Reka UI, and Tailwind CSS.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "components.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    }
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3310 & vite build --watch",
    "build": "pnpm build:types && vite build",
    "build:showcase": "vite build --mode showcase",
    "build:types": "pnpm exec vue-tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec vue-tsc -p tsconfig.app.json --noEmit && pnpm exec tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview --mode showcase"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@activelane/icons": "workspace:*",
    "@internationalized/date": "^3.10.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/vue": "^1.6.1",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "reka-ui": "^2.6.1",
    "shadcn-vue": "^2.6.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.30",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^2.0.5",
    "vue-tsc": "^3.2.6"
  },
  "keywords": [
    "activelane",
    "shadcn-vue",
    "reka-ui",
    "vue",
    "tailwindcss",
    "design-system"
  ],
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
