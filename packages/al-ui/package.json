{
  "name": "@activelane/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "ActiveLane's compact, accessible Vue UI system.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "development": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./blocks": {
      "development": "./src/blocks/index.ts",
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks.js"
    },
    "./theme": {
      "development": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./providers": {
      "development": "./src/providers/index.ts",
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers.js"
    },
    "./composables": {
      "development": "./src/composables/index.ts",
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables.js"
    },
    "./catalog": {
      "development": "./src/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./styles.css": {
      "development": "./src/styles/index.css",
      "default": "./dist/styles.css"
    }
  },
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles/index.css"
  ],
  "scripts": {
    "dev:showcase": "cd showcase && vite dev",
    "build": "vite build && pnpm build:types",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsx --test tests/*.test.mjs",
    "test:bundle": "node tests/bundle-check.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@activelane/icons": "workspace:*",
    "naive-ui": "^2.43.2",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "^3.5.41",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.27.7",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  },
  "keywords": [
    "activelane",
    "vue",
    "naive-ui",
    "design-system"
  ],
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
