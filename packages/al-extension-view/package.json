{
  "name": "@activelane/extension-view",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-neutral client for isolated ActiveLane extension views.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "development": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "build:types": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": { "tsx": "^4.21.0", "typescript": "~6.0.0", "vite": "^8.0.8" }
}
