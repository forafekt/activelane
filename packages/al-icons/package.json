{
  "name": "@activelane/icons",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Thin namespace-qualified Iconify integration for ActiveLane.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.mjs",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify/vue": "^5.0.1",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vue/server-renderer": "^3.5.41",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.8"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.12.0"
}
