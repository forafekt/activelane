<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="activelane"
        Arguments=""
        InstallLocation="C:\Program Files\ActiveLane">
    </Installer>
    <PackageInformation
        PackageName="ActiveLane"
        PackageDisplayName="ActiveLane"
        PublisherName="CN=ActiveLane"
        PublisherDisplayName="ActiveLane"
        Version="0.1.0.0"
        PackageDescription="ActiveLane Workbench">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.activelane.workbench"
                Description="ActiveLane Workbench"
                DisplayName="ActiveLane"
                ExecutableName="activelane"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ActiveLane</DisplayName>
            <PublisherDisplayName>ActiveLane</PublisherDisplayName>
            <Description>ActiveLane Workbench</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="activelane.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
